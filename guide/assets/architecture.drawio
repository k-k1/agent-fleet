        <mxCell id="e7" value="egress" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#4D5761;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ws" target="nat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note1" value="Login is the Control Plane&#x27;s own OAuth/OIDC — the ALB only terminates TLS.&#10;&#10;CloudFormation creates the substrate only (00-network / 10-data / 20-platform / 30-ingress / 40-ec2-pool). The per-member Workspace — its ECS service, task definition, EFS access point and EC2 slot — is created by the Control Plane at run time, not by a template.&#10;&#10;WAF, ACM, ECR and CloudWatch are drawn without edges to keep the request path readable." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1260" y="150" width="290" height="300" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="compose" name="Self-hosted (Docker Compose)">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="b" value="Team member&#10;(browser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="hostbox" value="One host (Docker Compose)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;verticalAlign=top;align=left;spacingLeft=12;dashed=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="60" width="760" height="360" as="geometry"/></mxCell>
        <mxCell id="caddy" value="Caddy&#10;automatic TLS (Let&#x27;s Encrypt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="280" y="120" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="cpc" value="control-plane&#10;Go — API / SSE / static Console" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280" y="240" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="wsc" value="workspace × N — one container per member" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fff8;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="260" height="230" as="geometry"/></mxCell>
        <mxCell id="agent" value="agent&#10;drives the CLI sessions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="570" y="170" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="cli" value="claude / codex / opencode …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="570" y="260" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="vol" value="volumes&#10;af-data + per-member home" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="840" y="240" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="f1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#4D5761;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b" target="caddy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#4D5761;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="caddy" target="cpc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" value="starts / stops" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#4D5761;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cpc" target="wsc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#4D5761;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="cli"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#4D5761;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="cpc" target="vol"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f7" value="home" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#4D5761;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="wsc" target="vol"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note2" value="The same Go core runs here and on AWS; only the deployment adapter differs (ports &amp; adapters — docs/dev/09-deploy.md).&#10;&#10;The control-plane starts member containers through the host&#x27;s Docker socket (Docker-outside-of-Docker), so a workspace is a sibling container, not a nested one." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1060" y="120" width="300" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
