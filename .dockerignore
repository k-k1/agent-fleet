# Build context for control-plane/Dockerfile is the repo root; keep it lean.
# (This root .dockerignore only affects root-context builds — i.e. the CP image.
# The workspace image builds with context workspace/ and is unaffected.)
.git
**/node_modules
console/dist
control-plane/control-plane
control-plane/af-cp
workspace/agent/agent
**/*.db
**/*.db-wal
**/*.db-shm

# Not needed to build the CP image.
# docs/ is the developer tree and must never be baked (ADR 0064); leaving it out of the
# context makes that structural. What ships is guide/, staged by the `docs` stage.
phase0
workspace
docs

# Per-deployment secrets (never bake into an image).
deploy/local/oauth.env
deploy/local/allowed-emails.txt
deploy/compose/.env

# Release artifacts (huge tars) must never enter the CP build context.
deploy/compose/dist
deploy/release/dist
