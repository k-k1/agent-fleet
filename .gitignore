# Local OAuth secrets (per-deployment; never commit).
# Copy deploy/local/oauth.env.example -> deploy/local/oauth.env and fill in.
deploy/local/oauth.env

# Per-deployment Google OAuth allowlist (AF_OAUTH_ALLOWED_EMAILS_FILE).
deploy/local/allowed-emails.txt

# On-prem compose per-deployment settings/secrets (P3-10). Copy .env.example -> .env.
deploy/compose/.env

# Local backup archives (backup.sh default OUT_DIR). Sensitive — never commit.
deploy/compose/backups/

# Release bundles built by release.sh.
deploy/compose/dist/

# Local build artifact from `go build` without -o (CP binary is built to /tmp/af-cp).
control-plane/control-plane

# compiled agent binary (built into image, never committed)
workspace/agent/agent
/tmp/af-cp
