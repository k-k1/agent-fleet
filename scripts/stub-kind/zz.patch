diff --git a/workspace/agent/internal/agents/zz/zz.go b/workspace/agent/internal/agents/zz/zz.go
new file mode 100644
index 000000000..ce329870e
--- /dev/null
+++ b/workspace/agent/internal/agents/zz/zz.go
@@ -0,0 +1,62 @@
+// Package zz is a stub kind used only to measure how many files a new kind touches
+// (scripts/stub-kind-count.sh). It is never merged.
+package zz
+
+import (
+	"github.com/k-k1/agent-fleet/workspace/agent/internal/agents"
+	"github.com/k-k1/agent-fleet/workspace/agent/internal/session"
+	"github.com/k-k1/agent-fleet/workspace/agent/internal/usagex"
+)
+
+type agentImpl struct{ agents.NoGenericTranscript }
+
+// New returns the zz kind's Agent.
+func New() agents.Agent { return agentImpl{} }
+
+func (agentImpl) Kind() string { return session.KindZz }
+
+func (agentImpl) Caps() agents.Caps { return agents.Caps{MCPClient: agents.TriNo} }
+
+func (agentImpl) BuildLaunch(m session.Meta, _ agents.LaunchOpts) (agents.LaunchPlan, error) {
+	if !session.DirExists(m.Dir) {
+		return agents.LaunchPlan{}, agents.DirGoneErr(m.Dir)
+	}
+	return agents.LaunchPlan{Program: "bash -l", Cwd: m.CWD()}, nil
+}
+
+func (agentImpl) WireLive(m session.Meta, alive bool) agents.LiveInfo {
+	return agents.LiveInfo{Resumable: alive || session.DirExists(m.Dir)}
+}
+
+func (agentImpl) ClearResume(string) {}
+
+// ListModels is agents.ModelLister: no model menu.
+func (agentImpl) ListModels(agents.ModelQuery) agents.ModelListing {
+	return agents.ModelListing{Enumerated: -1}
+}
+
+// PaneMode is agents.PaneModeReader: the stub draws no composer of its own.
+func (agentImpl) PaneMode(string) string { return "" }
+
+// SendWaitsForComposer is agents.PaneModeReader.
+func (agentImpl) SendWaitsForComposer() bool { return false }
+
+// PromptModal is agents.ModalProbe: the stub shows no modal.
+func (agentImpl) PromptModal(session.Meta) string { return "" }
+
+// InstructionsUnsupported is agents.InstructionsUnsupported: the stub takes no user instructions.
+func (agentImpl) InstructionsUnsupported() string { return "no_user_scope" }
+
+// MoveTarget is agents.MoveTarget: the stub's read has not been measured.
+func (agentImpl) MoveTarget() agents.MoveTargetState { return agents.MoveTargetUnmeasured }
+
+// UsageMeasured is agents.UsageMeasurer: the stub reports no tokens.
+func (agentImpl) UsageMeasured() string { return usagex.MeasuredNone }
+
+// NoHeadlessChat is agents.NoHeadlessChat: the stub has no chat backend.
+func (agentImpl) NoHeadlessChat() {}
+
+// SkillsLayout is agents.SkillsLayouter: foreign entries only.
+func (agentImpl) SkillsLayout() agents.SkillsLayout {
+	return agents.SkillsLayout{Native: agents.SkillsForeignOnly}
+}
