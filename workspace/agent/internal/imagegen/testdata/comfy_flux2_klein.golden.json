{
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b_fp8_mixed.safetensors",
      "device": "default",
      "type": "flux2"
    }
  },
  "dec": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sca",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "cfg": 1,
      "model": [
        "unet",
        0
      ],
      "negative": [
        "zero",
        0
      ],
      "positive": [
        "pos",
        0
      ]
    }
  },
  "lat": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "batch_size": 1,
      "height": 1024,
      "width": 1024
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 1234
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": "a red fox sitting on a mossy rock in a misty forest at dawn, detailed fur, soft light"
    }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "af-klein",
      "images": [
        "dec",
        0
      ]
    }
  },
  "sca": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "guider": [
        "guider",
        0
      ],
      "latent_image": [
        "lat",
        0
      ],
      "noise": [
        "noise",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "sigmas",
        0
      ]
    }
  },
  "sigmas": {
    "class_type": "Flux2Scheduler",
    "inputs": {
      "height": 1024,
      "steps": 4,
      "width": 1024
    }
  },
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux-2-klein-4b.safetensors",
      "weight_dtype": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    }
  },
  "zero": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "pos",
        0
      ]
    }
  }
