# The CP's deployment-specific settings (docs/build/09 sec.9.4). Secrets do not go here:
# they go in the Secret af-cp-secrets (README, "Secrets").
PUBLIC_BASE_URL=https://agent-fleet.example.com
PUBLIC_DOMAIN=agent-fleet.example.com
AUTH=oauth
# One per proxy in front of the CP: count yours.
AF_TRUSTED_PROXY_HOPS=1
SUPER_ADMIN_EMAILS=admin@example.com
AF_OAUTH_ALLOWED_DOMAINS=example.com
# Remote MCP (/mcp) and its OAuth sign-in; uncomment to turn on. The CP accepts exactly
# "true" and "1" (guide/operate/04-secure.md, "Sign-in for remote MCP clients").
#AF_MCP_ENABLED=true
#AF_MCP_OAUTH=1
