# The CP's deployment-specific settings (docs/build/09 sec.9.4). Secrets do not go here:
# they go in the Secret af-cp-secrets (README, "Secrets").
PUBLIC_BASE_URL=https://agent-fleet.example.com
PUBLIC_DOMAIN=agent-fleet.example.com
# Parent of the preview subdomains; the certificate covers *.<this> (deploy/gcp/gke).
# Leave empty for path-mode previews only.
AF_PREVIEW_DOMAIN=preview.agent-fleet.example.com
AUTH=oauth
# The global external Application Load Balancer appends "<client>, <load balancer>", and
# clientip.go counts from the right (ADR 0106 decision 1). Keep 2. Raising it for a proxy
# in front of the load balancer is unsafe while the load balancer can be reached directly:
# a client sending its own X-Forwarded-For would then choose its address (README, "The load
# balancer").
AF_TRUSTED_PROXY_HOPS=2
SUPER_ADMIN_EMAILS=admin@example.com
AF_OAUTH_ALLOWED_DOMAINS=example.com
GOOGLE_OAUTH_CLIENT_ID=0000000000-example.apps.googleusercontent.com
# Default claim sizes for a new workspace, in GiB (the adapter's defaults apply when unset).
#AF_K8S_HOME_GIB=50
#AF_K8S_STATE_GIB=5
