# Copy to terraform.tfvars (gitignored) and fill in. Every value here is an example.
project_id  = "example-project"
region      = "europe-west1"
node_zones  = ["europe-west1-b", "europe-west1-c"]
name_prefix = "af-example"

dns_zone       = "example-zone"
fqdn           = "agent-fleet.example.com"
preview_domain = "preview.agent-fleet.example.com"

authorized_networks = [
  { cidr_block = "203.0.113.0/24", display_name = "operators" },
]

artifact_registry_repository = {
  location   = "europe-west1"
  repository = "agent-fleet"
}
workspace_image = "europe-west1-docker.pkg.dev/example-project/agent-fleet/workspace:VERSION"

# --- Small, low-cost profile (README, "Small profile") -----------------------------------
# Well under half of the defaults' standing cost, for trials and a single team. It gives up
# the control plane's and the database's high availability and survival of a zone failure.
# Uncomment all of it, and replace node_zones above with one zone:
#
# node_zones             = ["europe-west1-b"]
# zonal_cluster          = true            # replaces the cluster if changed later
# system_machine_type    = "e2-standard-2" # e2-medium does not fit kube-system plus the CP
# system_node_count      = 1
# workspace_machine_type = "n2-standard-4" # a workspace pod must still fit on one node
# sql_availability_type  = "ZONAL"
# sql_tier               = "db-custom-1-3840"
# managed_prometheus     = false
