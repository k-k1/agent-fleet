# Copy to terraform.tfvars (gitignored) and fill in. Every value here is an example.
project_id  = "example-project"
region      = "europe-west1"
node_zones  = ["europe-west1-b", "europe-west1-c"]
name_prefix = "af-example"

dns_zone       = "example-zone"
fqdn           = "agent-fleet.example.com"
preview_domain = "preview.agent-fleet.example.com"

authorized_networks = [
  { cidr_block = "203.0.113.0/24", display_name = "operators" },
]

artifact_registry_repository = {
  location   = "europe-west1"
  repository = "agent-fleet"
}
workspace_image = "europe-west1-docker.pkg.dev/example-project/agent-fleet/workspace:VERSION"
