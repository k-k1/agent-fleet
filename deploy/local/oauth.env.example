# git-provider OAuth config for the Control Plane.
# Copy to deploy/local/oauth.env (git-ignored) and fill in. run-dev.sh auto-sources it.
# These enable the "OAuth 接続" buttons in the Console; without them the Console
# falls back to token paste (PAT / API token), which still works.

# GitHub OAuth App with "Enable Device Flow" turned ON. client_id is NOT secret.
#   Create: GitHub Settings -> Developer settings -> OAuth Apps
GITHUB_OAUTH_CLIENT_ID=

# Bitbucket OAuth consumer (Workspace settings -> OAuth consumers).
#   Permissions: Repositories: Write (+ Account: Read).
#   Callback URL MUST equal: $PUBLIC_BASE_URL/api/oauth/bitbucket/callback
BITBUCKET_OAUTH_KEY=
BITBUCKET_OAUTH_SECRET=

# External base URL the Console is served at (used to build the Bitbucket redirect_uri).
PUBLIC_BASE_URL=https://af.example.ts.net/agent-fleet
