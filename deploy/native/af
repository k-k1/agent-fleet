#!/usr/bin/env bash
# Agent Fleet — native launcher (docs/log/35 §35.3.1 / §35.7.2-8).
# Extract the tar, run `./af start`, then open http://localhost:8099 in a browser.
#
#   ./af start [--rootfs <tar.zst>]   # first run: fetch rootfs (sha256-verified) and extract
#   ./af update [--check] [--yes]     # stage the latest release (sha256-verified); does NOT restart
#   ./af reset [--all] [--yes]        # wipe local data (--all includes the extracted rootfs)
#   ./af status                       # show CP / workspace liveness
#
# Host requirements: Linux kernel (unprivileged user namespaces) + bash/coreutils/tar +
# curl or wget. zstd is bundled as bin/zstd, so the host does not need it.
# See the bundled README.md for details.
set -euo pipefail

# Resolve the real path so the package directory is found even when launched via
# symlink (install.sh links ~/.local/bin/af -> <pkg>/af); readlink -f is coreutils.
PKG="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
WS_DATA="${WS_DATA:-$HOME/.local/share/agent-fleet}"
CP_ADDR="${CP_ADDR:-127.0.0.1:8099}"
DEV_KEY="${DEV_USER:-dev}"

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"; }

# ---- distribution metadata (for `af update`; docs/log/42) ------------------------
# Where `af update` fetches new releases from. Baked as dist.json at build time
# (paired with install.sh's defaults); env overrides win. Kept in sync with the
# one-liner installer so update and install resolve the same artifacts.
dist_get() { sed -n 's/.*"'"$1"'": *"\{0,1\}\([^",}]*\)"\{0,1\}.*/\1/p' "$PKG/dist.json" 2>/dev/null | head -1; }
DIST_REPO="${AF_DIST_REPO:-$(dist_get repo)}"; : "${DIST_REPO:=k-k1/agent-fleet-dist}"
DIST_URL_BASE="${AF_DIST_URL_BASE:-$(dist_get url_base)}"; : "${DIST_URL_BASE:=https://github.com/$DIST_REPO/releases/download}"

# fetch <url> <out> — curl if present, else wget (bundled tools do not include either).
fetch() {
  if command -v curl >/dev/null 2>&1; then curl -fsSL -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then wget -qO "$2" "$1"
  else echo "ERROR: neither curl nor wget is available (cannot fetch)." >&2; return 1; fi
}

# Extract one key from rootfs.json (builder-generated, pretty-printed JSON). Read
# with sed so the host does not need jq (the format is paired with the builder).
manifest_get() {
  sed -n 's/.*"'"$1"'": *"\{0,1\}\([^",}]*\)"\{0,1\}.*/\1/p' "$PKG/rootfs.json" | head -1
}

# ---- rootfs fetch and extraction ---------------------------------------------
# Precedence: explicit --rootfs > bundled in package (rootfs/ of the --bundle-rootfs
# variant) > URL download. Every path verifies against the sha256 in rootfs.json
# before extracting (tampering/truncation is caught before startup). If the same
# version <r> is already extracted, do nothing = later starts work offline.
ensure_rootfs() {
  local explicit_tar="$1"
  R_VER="$(manifest_get version)"
  local sha url dest tar dl=0
  sha="$(manifest_get sha256)"
  url="$(manifest_get url)"
  [ -n "$R_VER" ] && [ -n "$sha" ] || { echo "ERROR: cannot read $PKG/rootfs.json" >&2; exit 1; }
  dest="$WS_DATA/shared/rootfs/$R_VER"
  ROOTFS_DIR="$dest"
  if [ -f "$dest/.ok" ]; then
    return 0
  fi
  mkdir -p "$WS_DATA/shared/rootfs"
  if [ -n "$explicit_tar" ]; then
    tar="$explicit_tar"
    [ -f "$tar" ] || { echo "ERROR: --rootfs $tar not found" >&2; exit 1; }
  elif ls "$PKG"/rootfs/*.tar.zst >/dev/null 2>&1; then
    tar="$(ls "$PKG"/rootfs/*.tar.zst | head -1)"
  else
    tar="$WS_DATA/shared/rootfs/.dl-$R_VER.tar.zst"
    dl=1
    echo "==> downloading rootfs $R_VER (first run only): $url"
    if command -v curl >/dev/null 2>&1; then
      curl -fL --progress-bar -o "$tar" "$url"
    elif command -v wget >/dev/null 2>&1; then
      wget -O "$tar" "$url"
    else
      echo "ERROR: neither curl nor wget is available (cannot fetch the rootfs)." >&2
      echo "       Fetch it on another host and pass it via ./af start --rootfs <tar.zst>." >&2
      exit 1
    fi
  fi
  echo "==> verifying rootfs (sha256)"
  echo "$sha  $tar" | sha256sum -c - >/dev/null \
    || { echo "ERROR: rootfs sha256 mismatch: $tar" >&2; exit 1; }
  echo "==> extracting rootfs -> $dest"
  local staging="$WS_DATA/shared/rootfs/.extract-$R_VER.$$"
  rm -rf "$staging"; mkdir -p "$staging"
  "$PKG/bin/zstd" -dc "$tar" | tar -x -C "$staging"
  rm -rf "$dest"
  mv "$staging" "$dest"
  touch "$dest/.ok"
  [ "$dl" = 1 ] && rm -f "$tar"
  return 0
}

# ---- install layout (install.sh symlink model) --------------------------------
# `af update` self-updates only when we are the install.sh layout:
#   <prefix>/opt/agent-fleet/<v>/af  <-  <prefix>/bin/af (symlink).
# Sets DEST_ROOT (…/opt/agent-fleet), BIN_LINK (…/bin/af). Returns 1 (and leaves
# BIN_LINK empty) for a hand-extracted copy, which cannot be swapped in place.
resolve_layout() {
  DEST_ROOT="$(dirname "$PKG")"
  local prefix; prefix="$(dirname "$(dirname "$DEST_ROOT")")"
  BIN_LINK="$prefix/bin/af"
  if [ -L "$BIN_LINK" ] && [ "$(readlink -f "$BIN_LINK")" = "$(readlink -f "$PKG/af")" ]; then
    return 0
  fi
  BIN_LINK=""
  return 1
}

# ---- preflight: can bwrap run with unprivileged userns? -----------------------
preflight() {
  if ! "$PKG/bin/bwrap" --unshare-user --uid 1000 --gid 1000 --ro-bind / / true 2>/dev/null; then
    cat >&2 <<'EOF'
ERROR: bubblewrap cannot run unprivileged (unprivileged user namespaces unavailable).
  Plain WSL2 normally works out of the box. On bare-metal Ubuntu 23.10+ you need to
  relax the AppArmor restriction once:
    sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
  To make it permanent, put the same setting under /etc/sysctl.d/ (see README.md).
  On kernels with userns disabled entirely, the native package cannot run
  (use the Docker setup instead).
EOF
    exit 1
  fi
}

do_start() {
  local rootfs_tar=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --rootfs) rootfs_tar="${2:?--rootfs requires a tar.zst path}"; shift 2 ;;
      *) echo "unknown option for start: $1" >&2; usage; exit 1 ;;
    esac
  done
  local ver=""
  [ -f "$PKG/VERSION" ] && ver="$(cat "$PKG/VERSION")"
  # Self-info for the CP's update surface (docs/log/42): AF_SELF_PKG is this running
  # package; AF_SELF_LINK is the ~/.local/bin/af symlink `af update` re-points, so
  # the CP can compare its baked version against what is staged on disk and offer
  # "restart to apply". Empty for hand-extracted copies. AF_SYSTEMD_UNIT is
  # inherited from the update-aware systemd unit (Environment=AF_SYSTEMD_UNIT=%N).
  resolve_layout || true
  ensure_rootfs "$rootfs_tar"
  preflight

  # git-provider OAuth config (if present). AUTH is fixed to dev on native (single user).
  if [ -f "$PKG/oauth.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "$PKG/oauth.env"
    set +a
    echo "==> loaded $PKG/oauth.env"
  fi

  echo "==> control-plane ${ver:+$ver }on $CP_ADDR  (console: http://${CP_ADDR/#127.0.0.1/localhost})  rootfs=$R_VER"
  exec env \
    CP_ADDR="$CP_ADDR" \
    AF_RUNTIME=native \
    AF_NATIVE_ROOTFS="$ROOTFS_DIR" \
    AF_NATIVE_BWRAP="$PKG/bin/bwrap" \
    CONSOLE_DIR="$PKG/console" \
    AF_DOCS_DIR="$PKG/docs" \
    GIT_HTTP_BACKEND="$PKG/bin/git-http-backend" \
    GIT_EXEC_PATH="$PKG/bin" \
    PATH="$PKG/bin:$PATH" \
    WS_DATA="$WS_DATA" \
    AUTH=dev \
    AF_SELF_PKG="$PKG" \
    ${BIN_LINK:+AF_SELF_LINK="$BIN_LINK"} \
    ${DEV_USER:+DEV_USER="$DEV_USER"} \
    ${PUBLIC_BASE_URL:+PUBLIC_BASE_URL="$PUBLIC_BASE_URL"} \
    ${AF_MASTER_KEY:+AF_MASTER_KEY="$AF_MASTER_KEY"} \
    ${AF_DB:+AF_DB="$AF_DB"} \
    ${AF_MCP_ENABLED:+AF_MCP_ENABLED="$AF_MCP_ENABLED"} \
    "$PKG/bin/af-cp"
}

# ---- update: stage the latest release (docs/log/42) -------------------------------
# Resolves the target version (AF_VERSION pins it; otherwise the latest release
# via the releases/latest redirect — no API rate limit), downloads + sha256-
# verifies the native tar against the release SHA256SUMS, extracts it next to the
# current version and atomically re-points ~/.local/bin/af. It never restarts a
# running control-plane: the running af-cp keeps serving until you restart it
# (systemctl --user restart agent-fleet) or apply from the Console. User data
# under WS_DATA is untouched; the new rootfs (if any) is fetched lazily on the
# next start.
resolve_latest() {
  local loc tag
  if command -v curl >/dev/null 2>&1; then
    loc="$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$DIST_REPO/releases/latest")" \
      || { echo "ERROR: cannot reach GitHub to resolve the latest release." >&2; return 1; }
    tag="${loc##*/}"
  else
    tag="$(fetch "https://api.github.com/repos/$DIST_REPO/releases/latest" /dev/stdout 2>/dev/null \
      | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)"
  fi
  case "$tag" in
    v[0-9]*) printf '%s\n' "${tag#v}" ;;
    *) echo "ERROR: cannot resolve the latest release (tag=$tag). Set AF_VERSION=<v>." >&2; return 1 ;;
  esac
}

do_update() {
  local check=0 yes=0 a
  for a in "$@"; do
    case "$a" in
      --check) check=1 ;;
      --yes | -y) yes=1 ;;
      *) echo "unknown option for update: $a" >&2; usage; exit 1 ;;
    esac
  done
  if ! resolve_layout; then
    echo "ERROR: 'af update' needs the standard install layout (~/.local/bin/af symlink)." >&2
    echo "       This copy looks hand-extracted — install with install.sh, or fetch the new" >&2
    echo "       tar yourself and extract it over this directory." >&2
    exit 1
  fi
  local cur=""; [ -f "$PKG/VERSION" ] && cur="$(cat "$PKG/VERSION")"
  local target="${AF_VERSION:-}"
  if [ -z "$target" ]; then target="$(resolve_latest)" || exit 1; fi
  if [ "$target" = "$cur" ]; then
    echo "already up to date (v$cur)"
    exit 0
  fi
  echo "==> update available: v${cur:-?} -> v$target"
  if [ "$check" = 1 ]; then exit 0; fi
  if [ "$yes" != 1 ] && [ -t 0 ]; then
    read -r -p "Download and stage v$target? [Y/n] " ans
    case "$ans" in n | N | no) echo "aborted"; exit 1 ;; *) : ;; esac
  fi

  local arch=amd64 name tmp
  name="agent-fleet-native-$target-linux-$arch"
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  echo "==> downloading $name.tar.gz"
  fetch "$DIST_URL_BASE/v$target/$name.tar.gz" "$tmp/$name.tar.gz" || exit 1
  fetch "$DIST_URL_BASE/v$target/SHA256SUMS" "$tmp/SHA256SUMS" || exit 1
  echo "==> verifying (sha256)"
  grep -E "  $name\.tar\.gz\$" "$tmp/SHA256SUMS" > "$tmp/want.sum" \
    || { echo "ERROR: SHA256SUMS has no entry for $name.tar.gz" >&2; exit 1; }
  (cd "$tmp" && sha256sum -c want.sum >/dev/null) \
    || { echo "ERROR: sha256 mismatch (corrupted download — retry)" >&2; exit 1; }
  echo "==> extracting -> $DEST_ROOT/$target"
  mkdir -p "$tmp/x"
  tar xzf "$tmp/$name.tar.gz" -C "$tmp/x"
  [ -x "$tmp/x/$name/af" ] || { echo "ERROR: unexpected tar contents (af is missing)" >&2; exit 1; }
  local staging="$DEST_ROOT/.staging-$target.$$"
  rm -rf "$staging"; mv "$tmp/x/$name" "$staging"
  rm -rf "${DEST_ROOT:?}/${target:?}"; mv "$staging" "$DEST_ROOT/$target"
  ln -sfn "$DEST_ROOT/$target/af" "$BIN_LINK"
  echo "==> staged v$target (running control-plane is unchanged until restart)"
  echo "    apply it with one of:"
  echo "      systemctl --user restart agent-fleet     # systemd users"
  echo "      # or click 'restart to apply' in the Console"
}

# ---- reset: wipe local data (port of run-dev.sh do_reset, without docker branches) --
do_reset() {
  local all=0 yes=0 a
  for a in "$@"; do
    case "$a" in
      --all) all=1 ;;
      --yes | -y) yes=1 ;;
      *) echo "unknown option for reset: $a" >&2; usage; exit 1 ;;
    esac
  done
  local target="$WS_DATA/$DEV_KEY"
  [ "$all" = 1 ] && target="$WS_DATA"
  if [ ! -e "$target" ]; then
    echo "nothing to delete (already clean): $target"
    exit 0
  fi
  if pgrep -f "$PKG/bin/af-cp" >/dev/null 2>&1; then
    echo "ERROR: control-plane (af-cp) is running. Stop it (Ctrl-C) and retry." >&2
    exit 1
  fi
  echo "==> will delete: $target"
  if [ "$all" = 1 ]; then
    echo "    full wipe: all of WS_DATA, incl. DB, all homes, claude-config, extracted rootfs"
  else
    echo "    user $DEV_KEY only: home / claude-config (incl. Claude login). DB and rootfs are kept"
  fi
  if [ "$yes" != 1 ]; then
    if [ -t 0 ]; then
      read -r -p "Really delete? [y/N] " ans
      case "$ans" in y | Y | yes) ;; *) echo "aborted"; exit 1 ;; esac
    else
      echo "ERROR: pass --yes for non-interactive runs" >&2
      exit 1
    fi
  fi
  # Workspace leftovers: kill the bwrap process group (tmux dies with the pid namespace).
  local pidf="$WS_DATA/$DEV_KEY/agent.pid" pid=""
  if pid="$(cat "$pidf" 2>/dev/null)" && [ -n "$pid" ]; then
    kill -TERM -- "-$pid" 2>/dev/null || true
    sleep 1
    kill -KILL -- "-$pid" 2>/dev/null || true
  fi
  # Go module caches inside workspace homes are write-protected (0555/0444 —
  # `go mod` does this on purpose), which makes a plain rm -rf fail with
  # "Permission denied". Restore owner write permission first.
  chmod -R u+w "$target" 2>/dev/null || true
  rm -rf "$target"
  echo "==> reset complete (recreated on next start)"
}

do_status() {
  if pgrep -f "$PKG/bin/af-cp" >/dev/null 2>&1; then
    echo "control-plane: running (http://${CP_ADDR/#127.0.0.1/localhost})"
  else
    echo "control-plane: stopped"
  fi
  local pidf pid name
  for pidf in "$WS_DATA"/*/agent.pid; do
    [ -f "$pidf" ] || continue
    name="$(basename "$(dirname "$pidf")")"
    pid="$(cat "$pidf" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "workspace $name: running (pid $pid)"
    else
      echo "workspace $name: stopped (stale pidfile)"
    fi
  done
}

case "${1:-}" in
  start) shift; do_start "$@" ;;
  update) shift; do_update "$@" ;;
  reset) shift; do_reset "$@" ;;
  status) shift; do_status ;;
  -h | --help | help | "") usage; exit 0 ;;
  *) echo "unknown subcommand: $1" >&2; usage; exit 1 ;;
esac
