# =============================================================================
# Agent Fleet — on-prem compose configuration (single source of truth).
#   cp .env.example .env   # then fill in the required values below.
# .env is git-ignored. NEVER commit real secrets. Generate secrets locally with
# the commands shown; do not reuse example values.
# Full walkthrough: deploy/compose/README.md (runbook).
# =============================================================================

# --- image distribution ------------------------------------------------------
# Images resolve to ${REGISTRY}/agent-fleet/{control-plane,workspace}:${VERSION}.
# For a local build use `docker compose up --build` (the build: sections apply).
REGISTRY=agent-fleet
VERSION=dev
# Workspace (per-user) image the CP launches via docker run.
WS_IMAGE=agent-fleet/workspace:dev

# --- host wiring (DooD constraints, see README §DooD) ------------------------
# Persistent data root: DB + per-user homes + secrets.enc + wrapped DEKs + Caddy
# certs. MUST be the SAME absolute path inside and outside the CP container, and
# NOT under /tmp (tmpfs = lost on reboot). Backups target this dir.
DATA_DIR=/srv/agent-fleet/data
# Host docker group GID (for docker.sock access). Find it with:
#   getent group docker | cut -d: -f3
DOCKER_GID=999
# CP bind address (loopback only; Caddy fronts it). Leave as-is unless fronting
# with your own proxy on a different port.
CP_ADDR=127.0.0.1:8099
# Per-workspace RAM cap (docker --memory). Raise with care on small hosts.
WS_MEMORY=5g

# --- public domain / TLS (Caddy, ACME) ---------------------------------------
# Point this domain's DNS A/AAAA record at this host; Caddy obtains a Let's
# Encrypt cert automatically. For internal testing use Caddyfile alternative 1
# (tls internal).
PUBLIC_DOMAIN=console.example.com
# External base URL the Console is served at (= https://<PUBLIC_DOMAIN>). Used to
# build OAuth redirect_uris; its https prefix also enables Secure cookies.
PUBLIC_BASE_URL=https://console.example.com

# --- authentication ----------------------------------------------------------
# AUTH=oauth  : CP-native Google OAuth (default for production).
# AUTH=proxy  : trust an upstream gateway's email header (AUTH_EMAIL_HEADER).
# AUTH=dev    : single fixed user (DEV_USER); local dev only, no auth.
AUTH=oauth
#AUTH_EMAIL_HEADER=X-Forwarded-Email   # AUTH=proxy only (default shown)
#DEV_USER=dev                          # AUTH=dev only

# Google OAuth 2.0 Web client. In Google Cloud Console add an Authorized redirect
# URI of  <PUBLIC_BASE_URL>/oauth2/callback  (see runbook).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Session cookie HMAC key. Generate once:  head -c 32 /dev/urandom | base64
AF_COOKIE_SECRET=
#AF_SESSION_TTL=168h                    # optional; default 168h (7 days)

# Login allowlist (fail-closed: all three empty => every login denied). Combine
# any. The _FILE is re-read on each login (one entry per line: exact email, or
# "@example.com" for a whole domain; # comments ok; use an ABSOLUTE path).
AF_OAUTH_ALLOWED_DOMAINS=example.com
#AF_OAUTH_ALLOWED_EMAILS=alice@example.com,bob@example.com
#AF_OAUTH_ALLOWED_EMAILS_FILE=/srv/agent-fleet/allowed-emails.txt

# First administrators (comma-separated emails granted identity.role=super_admin).
SUPER_ADMIN_EMAILS=admin@example.com
# Provisioning policy for unknown (allow-listed) identities:
#   auto   = gateway-trusted, auto-create a default-tenant membership (default)
#   invite = deny until an admin adds them
#AF_PROVISION=auto

# --- at-rest credential encryption (CRITICAL) --------------------------------
# Master key sealing every per-workspace DEK (envelope crypto). Generate once:
#   head -c 32 /dev/urandom | base64
# ⚠️ LOSING THIS = CRYPTO-SHRED: all stored credentials (and backups) become
#    permanently undecryptable. Store it in a SEPARATE vault from DATA_DIR/DB and
#    back it up independently. Unset => no encryption (dev: plaintext secrets).
AF_MASTER_KEY=

# --- optional features -------------------------------------------------------
# MCP endpoint (/mcp) so members can drive their remote sessions from local Claude.
#AF_MCP_ENABLED=1
# Idle auto-stop (scale-to-zero). Unset => globally disabled. Per-tenant overrides
# live in the DB (Admin UI). Durations like 30m/60m; AF_IDLE_SWEEP_INTERVAL=0 off.
#AF_SESSION_IDLE_TIMEOUT=30m
#AF_WS_IDLE_TIMEOUT=60m
#AF_IDLE_SWEEP_INTERVAL=60s
# git-provider OAuth (enables the Console "Connect" buttons; token paste works
# without them). Callback URLs: GitHub uses device flow (no callback);
# Bitbucket callback = <PUBLIC_BASE_URL>/api/oauth/bitbucket/callback.
#GITHUB_OAUTH_CLIENT_ID=
#BITBUCKET_OAUTH_KEY=
#BITBUCKET_OAUTH_SECRET=

# --- advanced (rarely changed) -----------------------------------------------
# Shared Temurin JDKs mounted read-only into every workspace. Auto-created under
# DATA_DIR; provision with deploy/local/provision-jvm.sh to actually populate.
#WS_JVM_DIR=/srv/agent-fleet/data/shared/jvm
# Base TCP port for per-workspace agent publishes (allocator floor).
#WS_AGENT_PORT=7700
# Override the SQLite path (default: ${DATA_DIR}/control-plane.db).
#AF_DB=/srv/agent-fleet/data/control-plane.db
