# agent-fleet on-prem compose — 環境設定 (P3-10 段1 版).
#   cp .env.example .env   # このファイルを .env にコピーして各社が埋める
# 秘密は絶対に .env.example にコミットしない（例値＋生成手順のみ）。.env は git-ignore 済。
# 段4 でここを全設定の単一ソースへ拡充する（Caddy/OAuth/backup 等）。

# --- イメージ配布 ------------------------------------------------------------
# REGISTRY/VERSION で image を解決（未設定なら agent-fleet/control-plane:dev）。
# ローカルビルド時は `docker compose up --build` で build セクションが使われる。
REGISTRY=agent-fleet
VERSION=dev
# workspace（ユーザーコンテナ）イメージ。CP が docker run で起動する。
WS_IMAGE=agent-fleet/workspace:dev

# --- ホスト依存（DooD §20.3） -----------------------------------------------
# 永続データ根（DB + per-user home + 共有JDK）。CP 内外で同一絶対パスになる（§20.3(B)）。
# /tmp 配下は避ける（tmpfs=再起動で消える）。
DATA_DIR=/srv/agent-fleet/data
# host の docker グループ GID。`getent group docker | cut -d: -f3` で確認して設定（§20.3(C)）。
DOCKER_GID=999
# CP の bind アドレス（loopback のみ）。段2 で Caddy を前段に置く。
CP_ADDR=127.0.0.1:8099

# --- ワークスペース資源 ------------------------------------------------------
WS_MEMORY=5g

# --- 認証 -------------------------------------------------------------------
# 本番は AUTH=oauth（CP ネイティブ Google OAuth）。以下は 段2/段4 で必須になる。
#AUTH=oauth
#PUBLIC_BASE_URL=https://console.example.com
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
#AF_COOKIE_SECRET=            # `openssl rand -hex 32`
#AF_OAUTH_ALLOWED_DOMAINS=example.com
#SUPER_ADMIN_EMAILS=admin@example.com

# --- 暗号化（最重要: 紛失＝全 crypto-shred, 段3 参照） -----------------------
#AF_MASTER_KEY=               # `openssl rand -hex 32`. DB/home と別金庫で保管。

# --- 任意 -------------------------------------------------------------------
#AF_MCP_ENABLED=1
# idle-stop 既定（未設定＝グローバル無効）。tenant.limits で個別上書き可。
#AF_SESSION_IDLE_TIMEOUT=30m
#AF_WS_IDLE_TIMEOUT=60m
#AF_IDLE_SWEEP_INTERVAL=0
