# =============================================================================
# Agent Fleet — on-prem compose configuration (single source of truth).
#   cp .env.example .env   # then fill in the required values below.
# .env is git-ignored. NEVER commit real secrets. Generate secrets locally with
# the commands shown; do not reuse example values.
# Full walkthrough: deploy/compose/README.md (runbook).
# =============================================================================

# --- image distribution ------------------------------------------------------
# Images resolve to ${REGISTRY}/{control-plane,workspace}:${VERSION} and are
# pulled from GHCR by default (ADR 0037) — `docker compose pull`, no login needed.
# Point REGISTRY at an internal mirror to pull from elsewhere; for a local build
# use `docker compose up --build` (the build: sections apply).
REGISTRY=ghcr.io/k-k1/agent-fleet
VERSION=dev
# Workspace (per-user) image the CP launches via docker run.
WS_IMAGE=agent-fleet/workspace:dev

# --- host wiring (DooD constraints, see README §DooD) ------------------------
# Persistent data root: DB + per-user homes + secrets.enc + wrapped DEKs + Caddy
# certs. MUST be the SAME absolute path inside and outside the CP container, and
# NOT under /tmp (tmpfs = lost on reboot). Backups target this dir.
DATA_DIR=/srv/agent-fleet/data
# Host docker group GID (for docker.sock access). Find it with:
#   getent group docker | cut -d: -f3
DOCKER_GID=999
# CP bind address (loopback only; Caddy fronts it). Leave as-is unless fronting
# with your own proxy on a different port.
CP_ADDR=127.0.0.1:8099
# Default per-workspace RAM cap (docker --memory) when no per-user override is set.
# Raise with care on small hosts.
WS_MEMORY=5g
# Optional HARD ceiling (bytes or 1024-suffix, e.g. 8g) for any per-workspace RAM
# override an admin sets from the Console. 0/unset = no extra ceiling beyond the
# per-tenant cap. A backstop so no single container can be sized past the host.
#AF_MAX_WORKSPACE_MEM=8g
# Runtime adapter (docs/09, P3-7). "local" = Docker Engine on this host (the only
# working target today). "ecs" selects the AWS adapter, which is a P3-7 stage-1
# skeleton — not yet functional. Leave unset/local for on-prem compose.
#AF_RUNTIME=local
# Showback (P3-9): how often to sample running workspaces for usage accounting
# (GET /api/admin/usage). Default 5m; set 0 to disable. DB writes only.
#AF_USAGE_SAMPLE_INTERVAL=5m

# --- public domain / TLS (Caddy, ACME) ---------------------------------------
# Point this domain's DNS A/AAAA record at this host; Caddy obtains a Let's
# Encrypt cert automatically. For internal testing use Caddyfile alternative 1
# (tls internal).
PUBLIC_DOMAIN=console.example.com
# External base URL the Console is served at (= https://<PUBLIC_DOMAIN>). Used to
# build OAuth redirect_uris; its https prefix also enables Secure cookies.
PUBLIC_BASE_URL=https://console.example.com
# How many proxies sit between a browser and the Control Plane. With the bundled
# Caddy in front (the default in this compose file) that is 1; with the CP exposed
# directly it is 0. The CP cannot work this out for itself, and it decides which
# address a request is attributed to: at 0 it uses the peer address and ignores
# X-Forwarded-For (correct with no proxy, and everyone looks like 127.0.0.1 with
# one), at N it reads the Nth entry from the RIGHT of X-Forwarded-For (a client can
# forge the left of that list, never the right). Only the per-tenant source-network
# restriction reads it today (docs/66), so leaving it wrong costs nothing until a
# tenant tries to use that — and then the save is refused rather than silently
# allowlisting the proxy.
AF_TRUSTED_PROXY_HOPS=1

# --- authentication ----------------------------------------------------------
# What to create on the IdP's side (Google Cloud Console / the Entra app
# registration / a GitHub OAuth App), which value goes into which key below, and
# how to check it: docs/guide/operator/05-login-idp.md
# AUTH=oauth  : CP-native login — Google and/or any OIDC IdP (default for production).
# AUTH=proxy  : trust an upstream gateway's email header (AUTH_EMAIL_HEADER).
#               This is also the answer for SAML IdPs (HENNGE One / TrustLogin /
#               CloudGate …): bridge them with oauth2-proxy or Keycloak.
# AUTH=dev    : single fixed user (DEV_USER); local dev only, no auth.
AUTH=oauth
#AUTH_EMAIL_HEADER=X-Forwarded-Email   # AUTH=proxy only (default shown)
#DEV_USER=dev                          # AUTH=dev only

# Google OAuth 2.0 Web client. In Google Cloud Console add an Authorized redirect
# URI of  <PUBLIC_BASE_URL>/oauth2/callback  (see runbook). Leave both empty if
# you only use an OIDC provider below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Session cookie HMAC key. Generate once:  head -c 32 /dev/urandom | base64
AF_COOKIE_SECRET=
#AF_SESSION_TTL=168h                    # optional; default 168h (7 days)

# --- OIDC login providers (Entra ID / Okta / Keycloak / Auth0 / Cognito / GitLab)
# One generic OIDC client covers them all (docs/61). Enable providers by listing
# their ids, then fill AF_OIDC_<ID>_* for each. The login page shows one button
# per enabled provider (Google included); with just one it looks as it does today.
# The redirect URI is ALWAYS <PUBLIC_BASE_URL>/oauth2/callback — register that one
# URI at the IdP no matter how many providers you enable.
#AF_OIDC_PROVIDERS=entra
#
# Microsoft Entra ID example (App registration -> Web platform, client secret):
#   ★ Pin the issuer to YOUR tenant guid. Using the /common/ or /organizations/
#     endpoint puts every Microsoft account in the world in front of the login,
#     and personal accounts can change their own email — so the CP refuses to
#     start on those unless AF_OIDC_<ID>_ALLOWED_TIDS is set.
#AF_OIDC_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-guid>/v2.0
#AF_OIDC_ENTRA_CLIENT_ID=<application-client-id>
#AF_OIDC_ENTRA_CLIENT_SECRET=<client-secret-value>
# How this IdP justifies the email it hands us (REQUIRED — no default):
#   email_verified = accept only when the IdP asserts email_verified (Google, most
#                    Okta / Keycloak / Auth0 setups)
#   issuer         = the issuer is pinned to one tenant, so its directory's address
#                    is trusted. Entra ID does not emit email_verified at all, so
#                    this is the correct value there.
#AF_OIDC_ENTRA_TRUST=issuer
# Button label (optional; default is generated from the id, e.g. "Sign in with Entra").
#AF_OIDC_ENTRA_LABEL_JA=Microsoft でサインイン
#AF_OIDC_ENTRA_LABEL_EN=Sign in with Microsoft
# Per-provider allowlist (optional). When set it REPLACES the deployment-wide
# AF_OAUTH_ALLOWED_* below for this provider; unset = the deployment-wide list.
#AF_OIDC_ENTRA_ALLOWED_DOMAINS=example.co.jp
#AF_OIDC_ENTRA_ALLOWED_EMAILS=alice@example.co.jp
# Accepted Entra tenant ids (tid). REQUIRED if the issuer is /common/ or
# /organizations/; otherwise unnecessary (the issuer already pins the tenant).
#AF_OIDC_ENTRA_ALLOWED_TIDS=<tenant-guid>
# Rarely needed: OAuth scopes (default "openid email profile") and the prompt
# parameter (default select_account; "none" omits it for IdPs that reject it).
#AF_OIDC_ENTRA_SCOPES=openid email profile
#AF_OIDC_ENTRA_PROMPT=select_account
#
# Okta / Keycloak / Auth0 / Cognito / GitLab are the same five lines, e.g.:
#AF_OIDC_PROVIDERS=okta
#AF_OIDC_OKTA_ISSUER=https://<your-org>.okta.com
#AF_OIDC_OKTA_CLIENT_ID=
#AF_OIDC_OKTA_CLIENT_SECRET=
#AF_OIDC_OKTA_TRUST=email_verified
# (Keycloak issuer looks like https://kc.example.com/realms/<realm>.)
#
# A provider with incomplete settings is disabled with a warning in the CP log —
# one broken IdP never locks everyone out. The CP only refuses to start when NO
# provider is usable at all.

# --- GitHub as a sign-in button (docs/61 §61.7)
# GitHub has no OIDC for user sign-in, so it is a separate adapter with its own
# settings. What authorizes a GitHub login is membership in one of these orgs —
# and setting this list is also what turns the button on. (GITHUB_OAUTH_CLIENT_ID
# further down keeps meaning only the git-connect device flow when this is empty.)
#AF_GITHUB_ALLOWED_ORGS=acme,acme-labs
#GITHUB_OAUTH_CLIENT_SECRET=<client-secret>
# ★ One OAuth App serves both the device flow and this login — just add the
#   callback URL <PUBLIC_BASE_URL>/oauth2/callback to it. To keep them separate
#   (approving an app for an org approves it for both), give the login its own:
#AF_GITHUB_LOGIN_CLIENT_ID=
#AF_GITHUB_LOGIN_CLIENT_SECRET=
# ★ If your org restricts third-party OAuth apps, an org owner must APPROVE the
#   app first. Until then the membership check sees nothing and everyone is
#   rejected — with settings that look perfectly correct.
# ★ Strongly recommended: gate on your company domain as well. GitHub gives us the
#   account's PRIMARY VERIFIED address, which is a personal one for most people,
#   and a personal address lands them in a NEW empty workspace instead of theirs
#   (accounts under different addresses are never merged). Refusing at the door is
#   kinder than letting someone work in a workspace they didn't mean to create.
#AF_GITHUB_ALLOWED_DOMAINS=example.com
#AF_GITHUB_ALLOWED_EMAILS=
#AF_GITHUB_LABEL_JA=GitHub でサインイン
#AF_GITHUB_LABEL_EN=Sign in with GitHub
# The org check is an API call, so a positive answer is cached per person for the
# TTL. If GitHub is unreachable at refresh time the last positive answer stands
# for the grace window and is refused after it. Note the cache lives in memory:
# after a CP restart these sessions are asked to sign in again (not rejected).
#AF_GITHUB_MEMBERSHIP_TTL=10m
#AF_GITHUB_MEMBERSHIP_GRACE=1h

# Login allowlist. Combine any. The _FILE is re-read on each login (one entry per
# line: exact email, or "@example.com" for a whole domain; # comments ok; use an
# ABSOLUTE path). Deleting someone here is the offboarding path: it takes effect
# on their very next request, without waiting for AF_SESSION_TTL.
#
# Someone INVITED to a tenant in the Admin panel gets in without appearing here,
# so an invite-run deployment can leave all three empty and keep one roster
# instead of two lists that drift apart. Fail-closed still holds: with no list,
# no member and no tenant auto-join domain, every login is denied — which is what
# a brand-new install looks like, so set at least one to get your first
# administrator in.
AF_OAUTH_ALLOWED_DOMAINS=example.com
#AF_OAUTH_ALLOWED_EMAILS=alice@example.com,bob@example.com
#AF_OAUTH_ALLOWED_EMAILS_FILE=/srv/agent-fleet/allowed-emails.txt

# First administrators (comma-separated emails granted identity.role=super_admin).
# Read ONCE AT STARTUP and treated as the only source of truth: on restart the CP
# also revokes the role from any account no longer listed here, which is how a
# handover completes for somebody who never signs in again. Changes need a CP
# restart. There is deliberately no way to promote a super_admin from the Console.
SUPER_ADMIN_EMAILS=admin@example.com
# Provisioning policy for identities with no tenant membership yet:
#   invite = deny until an admin adds them  ← what this template ships with
#   auto   = gateway-trusted, auto-create a default-tenant membership
# A tenant's own auto_join_domains (set in the Admin panel) is checked BEFORE
# either of these. Starting on invite works from the first boot: a
# SUPER_ADMIN_EMAILS account reaches the Admin panel with no membership of its own,
# and anyone else lands on a "you haven't been invited yet" page that tells them
# which address to quote to you.
#
# ★ Set here rather than changed in the code, so EXISTING deployments are not
# touched: the built-in default stays `auto`, and an .env that says nothing keeps
# behaving exactly as it did. Only new installs made from this template start
# closed. Deriving it at runtime instead ("invite when there are no members yet")
# was rejected — the condition stops holding the moment the first person joins, so
# the next restart would silently reopen the deployment (docs/61 §61.17.7).
#
# If you WANT the open behaviour — a small single-team install where everyone who
# can sign in should just get a workspace — set this to `auto`, and note that
# AF_OAUTH_ALLOWED_* is then the only thing standing between a stranger and a
# workspace.
AF_PROVISION=invite

# --- at-rest credential encryption (CRITICAL) --------------------------------
# Master key sealing every per-workspace DEK (envelope crypto). Generate once:
#   head -c 32 /dev/urandom | base64
# ⚠️ LOSING THIS = CRYPTO-SHRED: all stored credentials (and backups) become
#    permanently undecryptable. Store it in a SEPARATE vault from DATA_DIR/DB and
#    back it up independently. Unset => no encryption (dev: plaintext secrets).
AF_MASTER_KEY=

# --- optional features -------------------------------------------------------
# MCP endpoint (/mcp) so members can drive their remote sessions from local Claude.
#AF_MCP_ENABLED=1
# Idle auto-stop (scale-to-zero). ON by default: an idle claude session is halted
# after 1h, a workspace with nothing running is stopped after 2h. Set these to change
# the deployment default, or to "0" to turn it off entirely; per-tenant overrides live
# in the DB (Admin UI) and a tenant's own "0" opts that tenant out.
# AF_IDLE_SWEEP_INTERVAL=0 stops the reaper itself (all four tiers).
#AF_SESSION_IDLE_TIMEOUT=1h
#AF_WS_IDLE_TIMEOUT=2h
#AF_IDLE_SWEEP_INTERVAL=60s
# Auto-start (scale-to-zero counterpart): a stopped workspace is started on demand
# when the user opens a terminal or creates a session. On by default; set 0 to
# require an explicit start click instead.
#AF_AUTOSTART=1
# Scheduled execution (docs/38): the CP scheduler goroutine that fires operator-authored
# schedules (cron/interval/once) on a wall-clock — it wakes a stopped workspace, injects
# the prompt, and reports back. ON by default with a 1m tick (unset = 1m); the tick is a
# single indexed query and a no-op while no schedule exists, so "a schedule you create
# actually fires" is the default. Set 0 to HARD-DISABLE it (no timed wakes at all) on a
# deployment where unattended workspace wakes are unwanted (cost/policy) — the Console then
# hides the schedules section and create/run-now warn that nothing will fire. Keep the tick
# coarse; the scheduler only needs to notice a due schedule, not fire sub-minute.
#AF_SCHEDULER_INTERVAL=1m
# Thundering-herd spread: schedules aligned to the same wall-clock (e.g. many at 09:00)
# fire spread across a deterministic per-schedule window up to this max, so a wake burst
# does not OOM the host. Default 2m; 0 disables (fire exactly on the slot).
#AF_SCHEDULE_JITTER=2m
# After a scheduled wake, hold the workspace up for this grace window before letting the
# idle reaper stop it again, so the injected turn (and any immediate follow-up) completes.
# Default 5m.
#AF_SCHEDULE_SETTLE=5m
# How long a scheduled fire waits for a just-woken workspace's agent to become reachable
# before giving up. Default 90s.
#AF_SCHEDULE_WAKE_TIMEOUT=90s
# git-provider OAuth (enables the Console "Connect" buttons; token paste works
# without them). Callback URLs: GitHub uses device flow (no callback);
# Bitbucket callback = <PUBLIC_BASE_URL>/api/oauth/bitbucket/callback.
# The same GITHUB_OAUTH_CLIENT_ID is reused if you also enable the GitHub SIGN-IN
# button above (AF_GITHUB_ALLOWED_ORGS); on its own it means only this device flow.
#GITHUB_OAUTH_CLIENT_ID=
#BITBUCKET_OAUTH_KEY=
#BITBUCKET_OAUTH_SECRET=

# --- advanced (rarely changed) -----------------------------------------------
# Shared Temurin JDKs mounted read-only into every workspace. Auto-created under
# DATA_DIR; provision with deploy/local/provision-jvm.sh to actually populate.
#WS_JVM_DIR=/srv/agent-fleet/data/shared/jvm
# Base TCP port for per-workspace agent publishes (allocator floor).
#WS_AGENT_PORT=7700
# Override the SQLite path (default: ${DATA_DIR}/control-plane.db).
#AF_DB=/srv/agent-fleet/data/control-plane.db
