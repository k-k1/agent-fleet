# Static tools builder (docs/log/35 §35.7.2-7 (iv); §35.9-5 decision "build ourselves").
# Statically builds bwrap / git+git-http-backend / zstd — bundled into native
# package C — from pinned-version sources on alpine (musl). No scavenged binaries
# (the only supply source is each upstream's release tarball). Extract via
# `docker build -o` (final scratch stage).
#
#   docker build -f deploy/release/native/Dockerfile.tools \
#     --output type=local,dest=<dir> deploy/release/native
#
# Version pins are ARGs (edit here to bump). GPL/LGPL attribution and pointers to
# corresponding source are in the repo NOTICE (git is GPLv2 — the upstream tarball
# is the corresponding source).
FROM alpine:3.22 AS build
ARG BUBBLEWRAP_VERSION=0.11.0
ARG GIT_VERSION=2.47.3
ARG ZSTD_VERSION=1.5.7
RUN apk add --no-cache build-base meson ninja pkgconf curl xz \
      libcap-dev libcap-static zlib-dev zlib-static
WORKDIR /work

# bubblewrap — static meson build (musl + libcap-static).
RUN set -eux; \
    curl -fsSL "https://github.com/containers/bubblewrap/releases/download/v${BUBBLEWRAP_VERSION}/bubblewrap-${BUBBLEWRAP_VERSION}.tar.xz" \
      | tar -xJ; \
    cd "bubblewrap-${BUBBLEWRAP_VERSION}"; \
    LDFLAGS=-static meson setup build -Dselinux=disabled -Dman=disabled \
      -Dbash_completion=disabled -Dzsh_completion=disabled -Dtests=false --prefer-static; \
    ninja -C build; \
    install -D -m 0755 build/bwrap /out/bwrap; \
    /out/bwrap --version

# git — static NO_CURL build (for the CP's internal git provider: local operations +
# the git-http-backend CGI only, no https, so libcurl+openssl can be skipped entirely).
RUN set -eux; \
    curl -fsSL "https://mirrors.edge.kernel.org/pub/software/scm/git/git-${GIT_VERSION}.tar.xz" \
      | tar -xJ; \
    cd "git-${GIT_VERSION}"; \
    make -j"$(nproc)" CC=cc LDFLAGS="-static" \
      NO_CURL=1 NO_OPENSSL=1 NO_EXPAT=1 NO_TCLTK=1 NO_GETTEXT=1 \
      NO_PERL=1 NO_PYTHON=1 NO_ICONV=1 NO_REGEX=NeedsStartEnd \
      git git-http-backend; \
    install -D -m 0755 git /out/git; \
    install -D -m 0755 git-http-backend /out/git-http-backend; \
    /out/git --version

# zstd — for the launcher's rootfs extraction (bundled so the host needs no zstd).
RUN set -eux; \
    curl -fsSL "https://github.com/facebook/zstd/releases/download/v${ZSTD_VERSION}/zstd-${ZSTD_VERSION}.tar.gz" \
      | tar -xz; \
    cd "zstd-${ZSTD_VERSION}"; \
    make -j"$(nproc)" -C programs zstd \
      LDFLAGS=-static HAVE_ZLIB=0 HAVE_LZMA=0 HAVE_LZ4=0; \
    install -D -m 0755 programs/zstd /out/zstd; \
    /out/zstd --version

# Verify everything is truly static (fail here if dynamic — ldd errors on static binaries).
RUN set -eux; for b in /out/bwrap /out/git /out/git-http-backend /out/zstd; do \
      ! ldd "$b" 2>/dev/null || { echo "NOT STATIC: $b"; exit 1; }; \
    done

FROM scratch
COPY --from=build /out /
