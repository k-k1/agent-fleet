# Builder for the Console dist (bundled into the native package). Same recipe as the
# console stage of control-plane/Dockerfile, but extracts only dist. Context is repo root.
#
#   docker build -f deploy/release/native/Dockerfile.console \
#     --output type=local,dest=<dir> .
FROM node:22-trixie AS build
WORKDIR /src/console
COPY console/package.json console/package-lock.json ./
RUN npm ci
COPY console/ ./
# mermaid/marp are heavy; raise the Node heap so the prod build doesn't OOM.
RUN NODE_OPTIONS=--max-old-space-size=4096 npm run build

FROM scratch
COPY --from=build /src/console/dist /console
