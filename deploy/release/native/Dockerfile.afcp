# Builder for af-cp (static CP binary for native). Same recipe as the build stage of
# control-plane/Dockerfile (CGO off, pure-Go sqlite, migrations via go:embed), but
# extracts just the binary instead of making an image. Context is repo root.
#
#   docker build -f deploy/release/native/Dockerfile.afcp \
#     --build-arg VERSION=<v> --output type=local,dest=<dir> .
FROM golang:1.26-trixie AS build
WORKDIR /src/control-plane
COPY control-plane/go.mod control-plane/go.sum ./
RUN go mod download
COPY control-plane/ ./
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
      -ldflags="-s -w -X main.buildVersion=${VERSION}" -o /out/af-cp .

FROM scratch
COPY --from=build /out/af-cp /af-cp
